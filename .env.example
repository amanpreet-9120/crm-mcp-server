# Copy to .env (never commit it). All optional. Real environment variables take precedence.
CRM_MCP_TOKEN=change-me
CRM_READ_ONLY=0
CRM_RESET_ON_START=0
PORT=8000

# Data source: sqlite (built-in demo, default) or hubspot
CRM_BACKEND=sqlite

# HubSpot: create a Service Key in Settings > Integrations > Service Keys
HUBSPOT_SERVICE_KEY=
# Field mapping. Defaults suit the demo loader (scripts/seed_hubspot.py).
# For a real portal, e.g. HUBSPOT_OWNER_PROPERTY=hubspot_owner_id
# HUBSPOT_OWNER_PROPERTY=mcp_sales_rep
# HUBSPOT_LAST_ACTIVITY_PROPERTY=mcp_last_activity_date
# HUBSPOT_NEXT_STEP_DATE_PROPERTY=mcp_next_step_date
